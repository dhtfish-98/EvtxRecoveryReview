include 项目文档/README.md 项目文档/ORIGIN.md 项目文档/DEFENSIVE_SCOPE.md 项目文档/VALIDATION.md 项目文档/NOTICE 项目文档/LICENSE
include pyproject.toml requirements-build.txt .gitattributes .gitignore
recursive-include 项目文档/evidence *.json
recursive-include tests *.py
recursive-include tools *.py
recursive-include .github *.yml
recursive-exclude * __pycache__ *.pyc

include SOURCE_MANIFEST.json 项目文档/ATTRIBUTION_UPDATE.json

include 项目文档/LICENSE_CLEANUP.json

# Directory layout: canonical docs and source build entry; generated trees are not sdist inputs.
graft 项目文档
include 构建.py 构建配置.json
prune Build/源码
prune Build/新构建
prune Build/输出
prune Build/环境
prune Build/缓存
prune Build/中间
prune Build/临时
global-exclude __pycache__ *.py[cod] .DS_Store

# Original logical paths exist only in the staged compatibility view.
include DEFENSIVE_SCOPE.md LICENSE LICENSE_CLEANUP.json NOTICE ORIGIN.md README.md VALIDATION.md
